# The workspace intentionally keeps @ngrx/* v21 (and primeng v21) alongside Angular 22 —
# those first-party deps are out of scope for the Angular 22 migration (bumping them would
# require a manual `ng update`). @ngrx/effects@21 declares `@angular/core@^21` as a peer,
# which conflicts with the root @angular/core@22, so `npm ci`/`npm install` must skip strict
# peer resolution. This mirrors the `--legacy-peer-deps` flag used to generate package-lock.json
# and keeps CI (`npm ci`) and local installs consistent.
legacy-peer-deps=true
